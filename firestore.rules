rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = usuario de Google cuyo email está en /admins.
    // Se verifica que el token tenga email (los links personales de la Fase 2 no lo tienen).
    function isAdmin() {
      return signedIn()
        && 'email' in request.auth.token
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Usuario del portal (pasajero / conductor / coordinador).
    // El custom token tiene claims { rol, opId, refId } pero NO email.
    function isPortalUser() {
      return signedIn()
        && 'opId' in request.auth.token
        && 'rol' in request.auth.token
        && request.auth.token.rol in ['pasajero', 'conductor', 'coordinador'];
    }

    // Portal user cuyo opId coincide con el operativo del path
    function portalEnOp(opId) {
      return isPortalUser() && request.auth.token.opId == opId;
    }

    // Usuario de agencia (acceso de solo lectura a sus operativos).
    // El custom token tiene claims { rol:'agencia', agenciaId } pero NO email.
    function isAgenciaUser() {
      return signedIn()
        && 'agenciaId' in request.auth.token
        && 'rol' in request.auth.token
        && request.auth.token.rol == 'agencia';
    }

    // Agencia user cuyo agenciaId coincide con el campo del operativo en Firestore
    function agenciaEnOp(opId) {
      return isAgenciaUser()
        && get(/databases/$(database)/documents/operativos/$(opId)).data.agenciaId
           == request.auth.token.agenciaId;
    }

    match /admins/{email} {
      // Cada usuario puede consultar SOLO su propio documento: así el login
      // distingue "no autorizado" de un error de conexión.
      allow get: if signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == email;
      allow list: if isAdmin();
      allow write: if false;
    }

    // Cotizaciones / reservas: las crea el cotizador público (sin login).
    // Solo se aceptan en estado inicial y sin marcas internas del servidor.
    match /reservas/{id} {
      allow create: if request.resource.data.estado == 'seña_pendiente'
        && !('notificado' in request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Avisos del panel: los crea el servidor (api/notificar, firebase-admin)
    // o una agencia para avisar que creó un nuevo operativo.
    match /notificaciones/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (isAgenciaUser()
            && request.resource.data.tipo == 'operativo_agencia'
            && request.resource.data.agenciaId == request.auth.token.agenciaId
            && request.resource.data.leida == false);
    }

    // Diagrama de ocupación (Gantt) — una colección por año: gantt_2026, gantt_2027...
    // Contiene destinos, notas y quién cargó cada viaje: solo admin.
    match /{coleccion}/{docId} {
      allow read, write: if coleccion.matches('gantt_[0-9]{4}') && isAdmin();
    }

    // Copia pública y mínima del Gantt (unidad + fechas + turnos) para que el
    // cotizador muestre disponibilidad sin exponer datos internos.
    match /ocupacion/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcm_tokens/{token} {
      allow read, write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flota/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /unidades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /receptivo_circuitos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /receptivo_transfers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /receptivo_movimientos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- Módulo Egresados ----------------
    // Acceso acotado para pasajeros, conductores y coordinadores vía links personales.

    match /agencias/{id} {
      allow read: if isAdmin()
        || (isAgenciaUser() && request.auth.token.agenciaId == id);
      allow write: if isAdmin();
    }

    // Usuarios de agencias: el admin gestiona; la agencia puede leer sus propios usuarios.
    match /agencia_users/{email} {
      allow read: if isAdmin()
        || (isAgenciaUser() && resource.data.agenciaId == request.auth.token.agenciaId);
      allow write: if isAdmin();
    }

    match /operativos/{opId} {
      // Agencias pueden listar/leer solo sus propios operativos (campo agenciaId)
      allow read: if isAdmin() || portalEnOp(opId)
        || (isAgenciaUser() && resource.data.agenciaId == request.auth.token.agenciaId);
      // Agencias pueden crear y actualizar sus propios operativos; solo admin puede borrar
      allow create: if isAdmin()
        || (isAgenciaUser() && request.resource.data.agenciaId == request.auth.token.agenciaId);
      allow update: if isAdmin()
        || (isAgenciaUser() && resource.data.agenciaId == request.auth.token.agenciaId);
      allow delete: if isAdmin();

      match /buses/{busId} {
        allow read: if isAdmin() || portalEnOp(opId) || agenciaEnOp(opId);
        allow write: if isAdmin() || agenciaEnOp(opId);
      }

      match /staff/{staffId} {
        allow read: if isAdmin() || portalEnOp(opId) || agenciaEnOp(opId);
        allow write: if isAdmin() || agenciaEnOp(opId);
      }

      match /itinerario/{dia} {
        allow read: if isAdmin() || portalEnOp(opId) || agenciaEnOp(opId);
        allow write: if isAdmin() || agenciaEnOp(opId);
      }

      match /avisos/{avisId} {
        allow read: if isAdmin() || portalEnOp(opId);
        allow write: if isAdmin();
      }

      match /pasajeros/{paxId} {
        // Conductores y coordinadores ven todos; pasajero solo su propio doc; agencias ven todos
        allow read: if isAdmin()
          || (portalEnOp(opId) && request.auth.token.rol in ['conductor', 'coordinador'])
          || (portalEnOp(opId) && request.auth.token.rol == 'pasajero' && request.auth.token.refId == paxId)
          || agenciaEnOp(opId);
        allow write: if isAdmin() || agenciaEnOp(opId);
      }

      match /ubicaciones/{busId} {
        // Cualquier usuario del portal puede leer (ver dónde está el bus)
        allow read: if isAdmin() || portalEnOp(opId);
        // Solo el conductor cuyo busId coincide puede escribir su posición
        allow create, update: if isAdmin()
          || (portalEnOp(opId)
              && request.auth.token.rol == 'conductor'
              && 'busId' in request.auth.token
              && request.auth.token.busId == busId);
        allow delete: if isAdmin();
      }

      match /checkins/{checkinId} {
        allow read: if isAdmin()
          || (portalEnOp(opId) && request.auth.token.rol in ['conductor', 'coordinador']);
        // Coordinadores: crear con campos validados
        allow create: if isAdmin()
          || (portalEnOp(opId)
              && request.auth.token.rol == 'coordinador'
              && request.resource.data.paxId == checkinId
              && request.resource.data.coordinadorId == request.auth.token.refId
              && request.resource.data.keys().hasOnly(['paxId','coordinadorId','codigo','creadoEn','actualizadoEn']));
        // Coordinadores: actualizar solo sin modificar creadoEn
        allow update: if isAdmin()
          || (portalEnOp(opId)
              && request.auth.token.rol == 'coordinador'
              && request.resource.data.paxId == checkinId
              && request.resource.data.coordinadorId == request.auth.token.refId
              && request.resource.data.creadoEn == resource.data.creadoEn
              && request.resource.data.keys().hasOnly(['paxId','coordinadorId','codigo','creadoEn','actualizadoEn']));
        allow delete: if isAdmin();
      }

      match /reportes/{repId} {
        allow read: if isAdmin() || portalEnOp(opId);
        allow create: if isAdmin()
          || (portalEnOp(opId) && request.auth.token.rol == 'conductor');
        allow update, delete: if isAdmin();
      }
    }

    match /conductores/{id} {
      allow read, write: if isAdmin();
    }

    match /accesos/{token} {
      allow read, update: if isAdmin();
      // Agencias pueden crear accesos para sus propios operativos
      allow create: if isAdmin()
        || (isAgenciaUser() && request.resource.data.agenciaId == request.auth.token.agenciaId);
      // Agencias pueden eliminar accesos de sus propios operativos (para regenerar)
      allow delete: if isAdmin()
        || (isAgenciaUser() && resource.data.agenciaId == request.auth.token.agenciaId);
    }

    // Códigos de acceso de un solo uso para el portal de agencias.
    // La validación se hace server-side; el cliente solo puede listar los suyos (admin).
    match /agencia_codigos/{codigo} {
      allow read, write: if isAdmin();
    }

    // Todo lo no listado queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
